---
import Base from "../layouts/Base.astro";
---

<Base
	title="The Curb Fund — grassroots giving, done right"
	description="The Curb Fund routes your donation to vetted local organizations. Tax-deductible through Every.org."
>
	<main id="main" class="container placeholder">
		<p class="eyebrow">Shell preview</p>
		<h1>The Curb Fund</h1>
		<p>
			Layout, type, and navigation only — page content lands in a later
			unit.
		</p>
	</main>
</Base>

<style>
	/* Temporary placeholder spacing so the shell is visible while building. */
	.placeholder {
		padding-block: clamp(3rem, 10vw, 6rem);
	}
	.placeholder h1 {
		margin-block: 0.25rem 0.75rem;
	}
</style>
