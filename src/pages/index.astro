---
import Base from "../layouts/Base.astro";

const orgs = [
	{
		name: "Rail Passengers Association",
		blurb:
			"America's oldest rail passenger advocacy group, fighting for a national network worth riding.",
		tag: "National",
		local: false,
	},
  // TODO: Get these guys on board 
	// {
	// 	name: "Parking Reform Network",
	// 	blurb:
	// 		"Ending the parking minimum regime that has consumed our cities.",
	// 	tag: "National",
	// 	local: false,
	// },
	{
		name: "Strong Towns",
		blurb:
			"Building a movement for financially resilient, human-scale communities.",
		tag: "National",
		local: false,
	},
	{
		name: "Transportation Alternatives",
		blurb:
			"Advocating for sustainable transportation options and equitable urban planning in NYC.",
		tag: "Local",
		local: true,
	},
  {
    name: "Yes In My Back Yard (YIMBY Action)",
    blurb: "Fighting for affordable housing and smart growth in California.",
    tag: "Local",
    local: true
  }
];

const steps = [
	{ n: "01", label: "We pre-selected and vetted 4 non profits" },
	{ n: "02", label: "You donate via our Every.org fundraiser" },
	{ n: "03", label: "Organizations receive charitable donations" },
];
---

<Base
	title="The Curb Fund — Fund the movement for better cities"
	description="Donate once. The Curb Fund distributes your contribution across the organizations fighting for better transit, human-scale urbanism, and parking reform — equitably, transparently, quarterly."
>
	<main id="main">
		<!-- 1. HERO ------------------------------------------------------ -->
		<section class="section hero">
			<div class="container">
				<p class="eyebrow">A fund for cities that work</p>
				<h1 class="hero__headline">
					Your city deserves better.
				</h1>
				<p class="hero__subhead lead">
					Donate once. 
          <br />
          We distribute your contribution across the
					organizations fighting for better transit, human-scale
					urbanism, parking reform, and access to housing. 
          <br />
          <!-- Equitably. Transparently. Quarterly. -->
				</p>
				<div class="hero__ctas">
					<a class="btn btn--give" href="#donate">Donate now</a>
					<!-- <a class="btn btn--ghost" href="/how-it-works"
						>See how it works</a
					> -->
				</div>
			</div>
		</section>

		<!-- 2. ORGANIZATIONS GRID --------------------------------------- -->
		<section class="section orgs" aria-labelledby="orgs-heading">
			<div class="container">
				<h2 id="orgs-heading" class="section__label">
					Where your money goes
				</h2>
				<ul class="orgs__grid" role="list">
					{
						orgs.map((org) => (
							<li>
								<a class="org-card" href={`/organizations#${org.name}`}>
									<h3 class="org-card__name">{org.name}</h3>
									<p class="org-card__blurb">{org.blurb}</p>
									<span
										class:list={[
											"tag",
											{ "tag--local": org.local },
										]}
									>
										{org.tag}
									</span>
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<!-- 3. HOW IT WORKS (abbreviated) ------------------------------- -->
		<section class="section how" aria-labelledby="how-heading">
			<div class="container">
				<h2 id="how-heading" class="section__label">How it works</h2>
				<ol class="how__steps" role="list">
					{
						steps.map((step) => (
							<li class="step">
								<span class="step__n">{step.n}</span>
								<span class="step__label">{step.label}</span>
							</li>
						))
					}
				</ol>
				<a class="text-link" href="https://www.every.org" target="_blank" rel="noopener"
					>Learn about Every.org <span aria-hidden="true">→</span></a
				>
			</div>
		</section>

		<!-- 3.5 WHY THE CURB FUND --------------------------------------- -->
		<section class="section why" aria-labelledby="why-heading">
			<div class="container why__inner">
				<h2 id="why-heading" class="section__label">Why The Curb Fund</h2>
				<p class="why__lead lead">
					Most of us want our neighborhoods to be safer, healthier, and
					more prosperous, but almost nobody has the time or energy to
					figure out which civic organizations are actually moving the
					needle.
				</p>
				<p>
					We do. This is the stuff we care about, and we've spent years
					following the groups doing the real work on transit, housing, and
					how our cities get built. So we made it simple: we pick a handful
					worth backing, give you just the highlights, and create a way to 
          contribute to them all at once through a fundraiser on every.org
				</p>
				<p>
					You don't have to become an expert. 
          You just have to care
				</p>
			</div>
		</section>

		<!-- 4. DONATE --------------------------------------------------- -->
		<section id="donate" class="section donate" aria-labelledby="donate-heading">
			<div class="container donate__inner">
				<h2 id="donate-heading">Ready to fund the movement?</h2>
				<p class="donate__subhead lead">
					Every dollar goes to charity. We take nothing.
				</p>

				<div class="donate__widget">
					<!-- The Every.org widget mounts into this element on load.
					     The <a> is the no-JS fallback; the mount script clears
					     it before injecting the widget so they never both show. -->
					<div id="every-donate-btn">
						<a
							class="btn btn--give"
							href="https://www.every.org/the-curb-fund"
							>Donate Now</a
						>
					</div>
				</div>

				<p class="donate__fineprint">
					Tax-deductible · Managed via Every.org · Cancel anytime
				</p>
			</div>
		</section>
	</main>
</Base>

<!-- Mount the Every.org donation widget. is:inline so it runs in place and can
     see the global `everyDotOrgDonateButton` set by the async script in <head>. -->
<script is:inline>
	(function () {
		function mountCurbFundWidget() {
			const mount = document.getElementById("every-donate-btn");
			if (!mount || !window.everyDotOrgDonateButton) return;

			// Swap the no-JS fallback link for a real trigger button, so clicking
			// opens the modal instead of navigating away to Every.org.
			mount.innerHTML =
				'<button type="button" id="every-donate-trigger" class="btn btn--give">Donate now</button>';
			
			window.everyDotOrgDonateButton.createWidget({
        label: 'Donate now',
				selector: "#every-donate-trigger",
				// Unique open-anchor. It must NOT equal the page's own #donate id:
				// Every.org reads this anchor from the URL as "keep the modal open,"
				// so when it collided with our #donate section, clicking X just
				// re-opened it. This decoupling is the actual fix.
				openAt: "every-donate",
        nonprofitSlug: 'special-fundraiser',
				fundraiserSlug: "the-curb-fund",
				defaultFrequency: "monthly",
        noExit: false,
				primaryColor: "#2f5d3a", // --color-accent
				addAmounts: [10, 25, 50, 100],
				completeDonationInNewTab: false,
			});
		}

		// The button.js script is async; it may or may not have loaded yet.
		if (window.everyDotOrgDonateButton) {
			mountCurbFundWidget();
		} else {
			const script = document.getElementById("every-donate-btn-js");
			if (script) script.addEventListener("load", mountCurbFundWidget);
		}
	})();
</script>

<style>
	/* ---- Section rhythm --------------------------------------------------- */
	.section {
		padding-block: clamp(3.5rem, 8vw, 6rem);
	}

	.section__label {
		font-size: var(--text-xl);
		margin-bottom: 2rem;
	}

	.lead {
		font-size: var(--text-lg);
		color: var(--color-muted);
	}

	/* ---- Hero ------------------------------------------------------------- */
	.hero {
		padding-top: clamp(3rem, 9vw, 6.5rem);
		/* overflow: hidden; */
	}

	/* Decorative logo, offset to the right of the hero text. Desktop only —
	   below 900px there isn't room beside the text, so it's omitted.
	   image-set() serves WebP where supported and falls back to PNG. */
	/* @media (min-width: 900px) {
		.hero {
			background-image: url("/curb-fund-logo.png");
			background-image: image-set(
				url("/curb-fund-logo.webp") type("image/webp"),
				url("/curb-fund-logo.png") type("image/png")
			);
			background-repeat: no-repeat;
			background-position: right clamp(1.5rem, 5vw, 4rem) center;
			background-size: min(36%, 400px) auto;
		}
	} */

	.hero__headline {
		margin-block: 0.5rem 1.25rem;
		max-width: 15ch;
	}

	.hero__subhead {
		max-width: 54ch;
	}

	.hero__ctas {
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem;
		margin-top: 2rem;
	}

	/* ---- Organizations grid ---------------------------------------------- */
	.orgs {
		border-top: 1px solid var(--color-line);
	}

	.orgs__grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.org-card {
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
		height: 100%;
		padding: 1.5rem;
		background: var(--color-accent-tint);
		border: 1px solid var(--color-line);
		border-radius: var(--radius);
		text-decoration: none;
		color: inherit;
		transition: border-color 140ms ease, transform 140ms ease,
			box-shadow 140ms ease;
	}

	.org-card:hover {
		border-color: var(--color-accent);
		transform: translateY(-2px);
		box-shadow: var(--shadow-md);
	}

	.org-card__name {
		font-size: 1.4rem;
		letter-spacing: var(--tracking-tight);
	}

	.org-card__blurb {
		max-width: none;
		color: var(--color-muted);
		font-size: var(--text-base);
	}

	/* pin the tag to the bottom so cards line up regardless of blurb length */
	.tag {
		align-self: flex-start;
		margin-top: auto;
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: var(--tracking-wide);
		text-transform: uppercase;
		padding: 0.28em 0.7em;
		border: 1px solid var(--color-line);
		border-radius: var(--radius-pill);
		color: var(--color-muted);
	}

	.tag--local {
		color: var(--color-accent-strong);
		/* white chip so it stays visible now that the card itself is tinted */
		background: var(--color-surface);
		border-color: transparent;
	}

	/* ---- How it works ----------------------------------------------------- */
	.how {
		border-top: 1px solid var(--color-line);
	}

	.how__steps {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
		margin: 0 0 2rem;
		padding: 0;
		list-style: none;
	}

	.step {
		flex: 1 1 160px;
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
		padding-block: 1rem;
		border-top: 2px solid var(--color-accent);
	}

	.step__n {
		font-family: var(--font-serif);
		font-size: var(--text-lg);
		color: var(--color-accent);
	}

	.step__label {
		font-weight: 600;
		font-size: var(--text-lg);
	}

	.text-link {
		display: inline-block;
		font-weight: 600;
		color: var(--color-accent-strong);
		text-decoration: none;
	}
	.text-link:hover {
		text-decoration: underline;
	}

	/* ---- Why The Curb Fund ------------------------------------------------ */
	.why {
		border-top: 1px solid var(--color-line);
	}

	.why__inner p {
		max-width: 60ch;
	}
	.why__inner p + p {
		margin-top: 1.1rem;
	}

	.why__lead {
		color: var(--color-ink);
	}

	/* ---- Donate ----------------------------------------------------------- */
	.donate {
		background: var(--color-accent-tint);
		border-top: 1px solid var(--color-line);
	}

	.donate__inner {
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.donate__subhead {
		margin-top: 0.75rem;
		color: var(--color-ink);
	}

	.donate__widget {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
		margin-top: 2rem;
	}

	.donate__fineprint {
		max-width: none;
		margin-top: 1.5rem;
		font-size: var(--text-sm);
		color: var(--color-muted);
	}

	/* ---- Responsive ------------------------------------------------------- */
	@media (max-width: 560px) {
		.orgs__grid {
			grid-template-columns: 1fr;
		}
		.step {
			flex-basis: 100%;
			justify-content: center;
		}
		/* center the How it works text on mobile */
		.how {
			text-align: center;
		}
	}
</style>
