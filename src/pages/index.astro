---
import Base from "../layouts/Base.astro";

const orgs = [
	{
		name: "Rail Passengers Association",
		blurb:
			"America's oldest rail passenger advocacy group, fighting for a national network worth riding.",
		tag: "National",
		local: false,
	},
  // TODO: Get these guys on board 
	// {
	// 	name: "Parking Reform Network",
	// 	blurb:
	// 		"Ending the parking minimum regime that has consumed our cities.",
	// 	tag: "National",
	// 	local: false,
	// },
	{
		name: "Strong Towns",
		blurb:
			"Building a movement for financially resilient, human-scale communities.",
		tag: "National",
		local: false,
	},
	{
		name: "Transportation Alternatives",
		blurb:
			"Advocating for sustainable transportation options and equitable urban planning in NYC.",
		tag: "Local",
		local: true,
	},
  {
    name: "Yes In My Back Yard (YIMBY Action)",
    blurb: "Fighting for affordable housing and smart growth in California.",
    tag: "Local",
    local: true
  }
];

const steps = [
	{ n: "01", label: "You donate" },
	{ n: "02", label: "We allocate" },
	{ n: "03", label: "Orgs receive" },
];
---

<Base
	title="The Curb Fund — fund the movement for better cities"
	description="Donate once. The Curb Fund distributes your contribution across the organizations fighting for better transit, human-scale urbanism, and parking reform — equitably, transparently, quarterly."
>
	<main id="main">
		<!-- 1. HERO ------------------------------------------------------ -->
		<section class="section hero">
			<div class="container">
				<p class="eyebrow">A fund for cities that work</p>
				<h1 class="hero__headline">
					Your city deserves better than this.
				</h1>
				<p class="hero__subhead lead">
					Donate once. 
          <br />
          We distribute your contribution across the
					organizations fighting for better transit, human-scale
					urbanism, parking reform, and access to housing. 
          <br />
          <!-- Equitably. Transparently. Quarterly. -->
				</p>
				<div class="hero__ctas">
					<a class="btn btn--give" href="#donate">Give monthly</a>
					<a class="btn btn--ghost" href="/how-it-works"
						>See how it works</a
					>
				</div>
			</div>
		</section>

		<!-- 2. ORGANIZATIONS GRID --------------------------------------- -->
		<section class="section orgs" aria-labelledby="orgs-heading">
			<div class="container">
				<h2 id="orgs-heading" class="section__label">
					Where your money goes
				</h2>
				<ul class="orgs__grid" role="list">
					{
						orgs.map((org) => (
							<li>
								<a class="org-card" href={`/organizations#${org.name}`}>
									<h3 class="org-card__name">{org.name}</h3>
									<p class="org-card__blurb">{org.blurb}</p>
									<span
										class:list={[
											"tag",
											{ "tag--local": org.local },
										]}
									>
										{org.tag}
									</span>
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<!-- 3. HOW IT WORKS (abbreviated) ------------------------------- -->
		<section class="section how" aria-labelledby="how-heading">
			<div class="container">
				<h2 id="how-heading" class="section__label">How it works</h2>
				<ol class="how__steps" role="list">
					{
						steps.map((step) => (
							<li class="step">
								<span class="step__n">{step.n}</span>
								<span class="step__label">{step.label}</span>
							</li>
						))
					}
				</ol>
				<a class="text-link" href="/how-it-works"
					>Learn how it works <span aria-hidden="true">→</span></a
				>
			</div>
		</section>

		<!-- 4. DONATE --------------------------------------------------- -->
		<section id="donate" class="section donate" aria-labelledby="donate-heading">
			<div class="container donate__inner">
				<h2 id="donate-heading">Ready to fund the movement?</h2>
				<p class="donate__subhead lead">
					Every dollar goes to charity. We take nothing.
				</p>

				<div class="donate__widget">
					<!-- The Every.org widget mounts into this element on load.
					     The <a> is the no-JS fallback; the mount script clears
					     it before injecting the widget so they never both show. -->
					<div id="every-donate-btn">
						<a
							class="btn btn--give"
							href="https://www.every.org/the-curb-fund"
							>Donate Now</a
						>
					</div>
				</div>

				<p class="donate__fineprint">
					Tax-deductible · Managed via Every.org · Cancel anytime
				</p>
			</div>
		</section>
	</main>
</Base>

<!-- Mount the Every.org donation widget. is:inline so it runs in place and can
     see the global `everyDotOrgDonateButton` set by the async script in <head>. -->
<script is:inline>
	(function () {
		function mountCurbFundWidget() {
			const mount = document.getElementById("every-donate-btn");
			if (!mount || !window.everyDotOrgDonateButton) return;
			
			window.everyDotOrgDonateButton.createWidget({
        label: 'Donate now',
				selector: "#every-donate-btn",
        nonprofitSlug: 'special-fundraiser',
				fundraiserSlug: "the-curb-fund",
				defaultFrequency: "monthly",
        noExit: false,
				primaryColor: "#2f5d3a", // --color-accent
				addAmounts: [10, 25, 50, 100],
				completeDonationInNewTab: false,
			});
		}

		// The button.js script is async; it may or may not have loaded yet.
		if (window.everyDotOrgDonateButton) {
			mountCurbFundWidget();
		} else {
			const script = document.getElementById("every-donate-btn-js");
      console.log({script})
			if (script) script.addEventListener("load", mountCurbFundWidget);
		}
	})();
</script>

<style>
	/* ---- Section rhythm --------------------------------------------------- */
	.section {
		padding-block: clamp(3.5rem, 8vw, 6rem);
	}

	.section__label {
		font-size: var(--text-xl);
		margin-bottom: 2rem;
	}

	.lead {
		font-size: var(--text-lg);
		color: var(--color-muted);
	}

	/* ---- Hero ------------------------------------------------------------- */
	.hero {
		padding-top: clamp(3rem, 9vw, 6.5rem);
	}

	.hero__headline {
		margin-block: 0.5rem 1.25rem;
		max-width: 15ch;
	}

	.hero__subhead {
		max-width: 54ch;
	}

	.hero__ctas {
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem;
		margin-top: 2rem;
	}

	/* ---- Organizations grid ---------------------------------------------- */
	.orgs {
		border-top: 1px solid var(--color-line);
	}

	.orgs__grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.org-card {
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
		height: 100%;
		padding: 1.5rem;
		background: var(--color-surface);
		border: 1px solid var(--color-line);
		border-radius: var(--radius);
		text-decoration: none;
		color: inherit;
		transition: border-color 140ms ease, transform 140ms ease,
			box-shadow 140ms ease;
	}

	.org-card:hover {
		border-color: var(--color-accent);
		transform: translateY(-2px);
		box-shadow: var(--shadow-md);
	}

	.org-card__name {
		font-size: 1.4rem;
		letter-spacing: var(--tracking-tight);
	}

	.org-card__blurb {
		max-width: none;
		color: var(--color-muted);
		font-size: var(--text-base);
	}

	/* pin the tag to the bottom so cards line up regardless of blurb length */
	.tag {
		align-self: flex-start;
		margin-top: auto;
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: var(--tracking-wide);
		text-transform: uppercase;
		padding: 0.28em 0.7em;
		border: 1px solid var(--color-line);
		border-radius: var(--radius-pill);
		color: var(--color-muted);
	}

	.tag--local {
		color: var(--color-accent-strong);
		background: var(--color-accent-tint);
		border-color: transparent;
	}

	/* ---- How it works ----------------------------------------------------- */
	.how {
		border-top: 1px solid var(--color-line);
	}

	.how__steps {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
		margin: 0 0 2rem;
		padding: 0;
		list-style: none;
	}

	.step {
		flex: 1 1 160px;
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
		padding-block: 1rem;
		border-top: 2px solid var(--color-accent);
	}

	.step__n {
		font-family: var(--font-serif);
		font-size: var(--text-lg);
		color: var(--color-accent);
	}

	.step__label {
		font-weight: 600;
		font-size: var(--text-lg);
	}

	.text-link {
		display: inline-block;
		font-weight: 600;
		color: var(--color-accent-strong);
		text-decoration: none;
	}
	.text-link:hover {
		text-decoration: underline;
	}

	/* ---- Donate ----------------------------------------------------------- */
	.donate {
		background: var(--color-accent-tint);
		border-top: 1px solid var(--color-line);
	}

	.donate__inner {
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.donate__subhead {
		margin-top: 0.75rem;
		color: var(--color-ink);
	}

	.donate__widget {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
		margin-top: 2rem;
	}

	.donate__fineprint {
		max-width: none;
		margin-top: 1.5rem;
		font-size: var(--text-sm);
		color: var(--color-muted);
	}

	/* ---- Responsive ------------------------------------------------------- */
	@media (max-width: 560px) {
		.orgs__grid {
			grid-template-columns: 1fr;
		}
		.step {
			flex-basis: 100%;
		}
	}
</style>
