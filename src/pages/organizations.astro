---
import Base from "../layouts/Base.astro";

// NOTE: `slug` is the org's Every.org profile slug (used for "Donate directly").
const orgs = [
	{
		name: "Rail Passengers Association",
		tag: "National",
		local: false,
		website: "https://www.railpassengers.org",
		slug: "rail-passengers-association",
		description:
			"The Rail Passengers Association is the largest national organization advocating for train riders in the United States. Founded in 1967, it represents the interests of the more than 40 million people who ride America's trains by lobbying Congress, mobilizing riders, and defending Amtrak's national network from the recurring threat of cuts.",
		why: "Passenger rail lives or dies by federal appropriations, and RPA is the only organized national constituency fighting for it year after year. Their work is unglamorous, legislative, and hard to fund through membership dues alone. This is the kind of durable advocacy that struggles to attract attention but moves the outcome.",
	},
	{
		name: "Strong Towns",
		tag: "National",
		local: false,
		website: "https://www.strongtowns.org",
		slug: "strong-towns",
		description:
			"Strong Towns is both a movement and a media organization arguing that American cities are financially insolvent because of how we've chosen to build them. Through writing, podcasts, and a national network of local advocates, they make the case for incremental, human-scale development that towns can actually afford to maintain.",
		why: "Strong Towns reframes the urbanist argument in fiscal terms that resonate across the political spectrum, reaching audiences other advocates can't. They've built a genuine grassroots movement rather than just a policy shop, and movements compound.",
	},
	{
		name: "Transportation Alternatives",
		tag: "Local",
		local: true,
		website: "https://transalt.org",
		slug: "transportation-alternatives",
		description:
			"Transportation Alternatives has spent five decades reclaiming New York City's streets from the automobile. They campaign for protected bike lanes, safer crossings, better transit, and car-free public space. Their grassroots organizing has reshaped how the largest city in the country moves.",
		why: "TA turns advocacy into concrete wins: miles of protected lanes, redesigned intersections, and landmark street-safety legislation. As our local match for the New York region, they demonstrate what sustained pressure on city government can actually achieve.",
	},
	{
		name: "Yes In My Back Yard (YIMBY Action)",
		tag: "Local",
		local: true,
		website: "https://yimbyaction.org",
		slug: "yes-in-my-back-yard",
		description:
			"YIMBY Action is a national network of local chapters fighting to legalize abundant, affordable housing. Through its 501(c)(3), Yes In My Back Yard, it trains and mobilizes volunteers to show up where housing actually gets decided - city councils, planning commissions, and statehouses - and say yes.",
		why: "The housing shortage is downstream of thousands of local land-use fights, and YIMBY Action is one of the few groups organizing ordinary residents to win them. Pro-housing voices are chronically outnumbered in those rooms; this is where funding moves the margin.",
	},
];
---

<Base
	title="Organizations we fund — The Curb Fund"
	description="The national and local urbanist organizations The Curb Fund supports — who they are, why we back them, and how to give to each directly."
>
	<main id="main">
		<!-- HERO ---------------------------------------------------------- -->
		<section class="page-hero">
			<div class="container">
				<p class="eyebrow">Where your money goes</p>
				<h1 class="page-hero__title">The organizations we fund</h1>
				<p class="lead">
					We back a small, curated set of national urbanist organizations
				  chosen for their track record, financial transparency, and the
					distinctiveness of their work.
				</p>
			</div>
		</section>

		<!-- ORG LIST ------------------------------------------------------ -->
		<section class="section section--tight">
			<div class="container">
				<ul class="org-list" role="list">
					{
						orgs.map((org) => (
							<li>
								<article class="org-detail">
									<header class="org-detail__head">
										<h2 class="org-detail__name">{org.name}</h2>
										<span
											class:list={[
												"tag",
												{ "tag--local": org.local },
											]}
										>
											{org.tag}
										</span>
									</header>

									<p class="org-detail__desc">{org.description}</p>
									<p class="org-detail__why">
										<strong>Why we fund them.</strong> {org.why}
									</p>

									<div class="org-detail__actions">
										<a
											class="btn btn--give"
											href={`https://www.every.org/${org.slug}#/donate`}
											target="_blank"
											rel="noopener"
										>
											Donate directly <span aria-hidden="true">→</span>
										</a>
										<a
											class="text-link"
											href={org.website}
											target="_blank"
											rel="noopener"
										>
											Visit website{" "}
											<span aria-hidden="true">↗</span>
										</a>
									</div>
								</article>
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<!-- HOW WE CHOOSE ------------------------------------------------- -->
		<section class="section--tight section--divide">
			<div class="container prose">
				<h2 class="section__label">How we choose</h2>
				<p>
					We keep the slate deliberately short. Adding an organization
					means diluting every other one's share, so each has to earn its
					place against three questions.
				</p>
				<p>
					<strong>Financial health.</strong> We look for organizations that
					publish their finances, spend responsibly, and aren't one grant
					away from folding. Transparency is a prerequisite, not a
					nice-to-have: if we can't see how an organization uses money, we
					can't ask you to give it any.
				</p>
				<p>
					<strong>Demonstrated impact.</strong> We favor groups with a
					concrete record of changing policy, shifting public opinion, or
					reshaping the built environment, not just producing reports.
					Where a marginal dollar plausibly buys a marginal win, that's
					where it should go.
				</p>
				<p>
					<strong>Doing work others aren't.</strong> We look for the
					organizations filling gaps performing the unglamorous, hard-to-fund
					advocacy that no one else is organized to do. Duplicating a
					well-funded effort is a poor use of your donation; backing the
					only group in the room is a good one.
				</p>
			</div>
		</section>
	</main>
</Base>

<style>
	.org-list {
		display: grid;
		gap: 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.org-detail {
		padding: clamp(1.5rem, 4vw, 2.25rem);
		background: var(--color-surface);
		border: 1px solid var(--color-line);
		border-radius: var(--radius);
	}

	.org-detail__head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1rem;
	}

	.org-detail__name {
		font-size: var(--text-xl);
	}

	.org-detail__desc,
	.org-detail__why {
		max-width: 64ch;
		color: var(--color-ink);
	}

	.org-detail__why {
		margin-top: 0.9rem;
		color: var(--color-muted);
	}

	.org-detail__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem 1.5rem;
		margin-top: 1.5rem;
	}

	@media (max-width: 480px) {
		.org-detail__head {
			flex-direction: column;
			gap: 0.5rem;
		}
	}
</style>
